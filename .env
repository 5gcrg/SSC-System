FRONTEND_URL=https://holidays-work-violations-lifetime.trycloudflare.com
# FRONTEND_URL=http://localhost:9003
# Server-side only (used by Next.js rewrites to proxy /api/* and /files/* to backend)
API_URL=http://localhost:9004
FILESERVER_URL=http://localhost:9005
