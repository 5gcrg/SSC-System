# ── Database ──────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ssc_booking
MYSQL_USER=sscuser
MYSQL_PASSWORD=sscpassword

# ── MinIO ─────────────────────────────
MINIO_ROOT_USER=sscadmin
MINIO_ROOT_PASSWORD=sscpassword123
MINIO_PORT=9006
MINIO_CONSOLE_PORT=9007
MINIO_URL=http://localhost:9006
MINIO_PUBLIC_URL=http://localhost:9006

# ── JWT (must match in both backends) ─
JWT_SECRET=dev-secret-key-change-in-production-must-be-at-least-32-characters-long

# ── Google OAuth ──────────────────────
GOOGLE_CLIENT_ID=483440253663-4hlia5o3c85g9q51m8h6afcd09j0vigb.apps.googleusercontent.com

# ── File Server ───────────────────────
FILESERVER_PORT=9005
FILESERVER_URL=http://localhost:9005

# ── Backend ───────────────────────────
BACKEND_PORT=9004
ALLOWED_ORIGINS=http://localhost:9003,http://localhost:9004

# ── Frontend ──────────────────────────
FRONTEND_PORT=9003
FRONTEND_URL=http://localhost:9003
NEXT_PUBLIC_API_URL=http://localhost:9004
NEXT_PUBLIC_FILESERVER_URL=http://localhost:9005
NEXT_PUBLIC_GOOGLE_CLIENT_ID=483440253663-4hlia5o3c85g9q51m8h6afcd09j0vigb.apps.googleusercontent.com

# ── Backend masterlist integration clients (read-only) ─
# Per-external-service keys for GET /api/v1/integration/** on the backend.
# Slot 1 falls back to the legacy MASTERLIST_API_KEY if MASTERLIST_CLIENT_1_KEY is unset.
MASTERLIST_CLIENT_1_NAME=registrar
MASTERLIST_CLIENT_1_KEY=<generate: openssl rand -hex 32; or move the existing MASTERLIST_API_KEY value here>
MASTERLIST_CLIENT_1_ALLOW_SENSITIVE=false
#MASTERLIST_CLIENT_2_NAME=
#MASTERLIST_CLIENT_2_KEY=
#MASTERLIST_CLIENT_2_ALLOW_SENSITIVE=false

# ── Fileserver project-storage clients ─
# Per-external-service keys for /api/v1/integration/files on the fileserver.
# Each client is confined to projects/<FOLDER>/ in the ssc-projects bucket.
PROJECT_CLIENT_1_NAME=acme
PROJECT_CLIENT_1_KEY=<generate: openssl rand -hex 32>
PROJECT_CLIENT_1_FOLDER=acme-app
#PROJECT_CLIENT_2_NAME=
#PROJECT_CLIENT_2_KEY=
#PROJECT_CLIENT_2_FOLDER=

# ── Mail ──────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=galaragajeferson@g.cjc.edu.ph
MAIL_PASSWORD=your-app-password-here
MAIL_FROM=galaragajeferson@g.cjc.edu.ph
MAIL_ENABLED=false

