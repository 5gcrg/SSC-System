# Copy outside the repository, e.g. C:\ProgramData\SSC-System\production.env.
# Never commit a filled-in production environment file.
DB_URL=jdbc:mysql://127.0.0.1:3306/ssc_booking?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=sscuser
DB_PASSWORD=CHANGE_ME
MYSQL_CLIENT_PATH=C:\xampp\mysql\bin\mysql.exe

FRONTEND_URL=https://ssc.example.edu.ph
MINIO_PUBLIC_URL=https://files.example.edu.ph
API_URL=http://127.0.0.1:9004
FILESERVER_URL=http://127.0.0.1:9005
MINIO_URL=http://127.0.0.1:9006
MINIO_DATA_DIR=C:\ProgramData\SSC-System\minio-data

GOOGLE_CLIENT_ID=CHANGE_ME
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET

# Create a dedicated MinIO app user with bucket-scoped permissions before using
# different app credentials; do not expose the MinIO console on the public internet.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
